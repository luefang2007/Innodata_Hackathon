# Copy to .env (git-ignored, never submitted) and fill in ONE team key.
# OpenRouter key (sk-or-...): generation runs through OpenRouter (the brief's recommended budget for generation).
OPENROUTER_API_KEY=
# Anthropic key (sk-ant-...): used if set; keep it for the Haiku benchmark if budget is tight.
ANTHROPIC_API_KEY=
